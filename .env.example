# ORXYZ Marketplace — example configuration only.
# Never commit real Stripe secrets, operator tokens, or buyer quote data.

# --- Public app URL ---
BASE_URL=http://localhost:8000

# --- Stripe (server-side only) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# --- Live money-movement gates: fail closed by default ---
LIVE_PAYMENTS_ENABLED=false
SUPPLIER_RELEASES_ENABLED=false
INSTANT_SPLITS_ENABLED=false

# Live checkout must also have a durable transaction ledger.
# The included SQLite ledger is for local/manual staging, not serverless production.
DURABLE_LEDGER_ENABLED=false
DATABASE_PATH=./orxyz_marketplace.db

# Long random bearer token protecting /ops/* endpoints.
ORXYZ_OPS_TOKEN=

# Approved quote registry. Keep supplier cost and buyer pricing server-side.
# Example only; do not copy this placeholder into production unchanged.
ORXYZ_APPROVED_QUOTES_JSON=[]

# --- Release rules (supplier-cost thresholds in USD) ---
AUTO_RELEASE_MAX_USD=5000
MANUAL_APPROVAL_MIN_USD=25000

# --- Risk reserve planning ---
ROLLING_RESERVE_PCT=0.10
ROLLING_RESERVE_FLOOR_USD=500
